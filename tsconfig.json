{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "lib": ["esnext"],

    // Other Outputs 
    "sourceMap": true, 
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options - DISABLED for Docker
    "noUncheckedIndexedAccess": false,

    // Style Options - DISABLED
    "noImplicitReturns": false,
    "noImplicitOverride": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "noPropertyAccessFromIndexSignature": false,

    // Recommended Options - LOOSENED for build
    "strict": false,           // ← CHANGE THIS from true to false
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noImplicitAny": false,    // ← Already false, good
    "strictNullChecks": false  // ← ADD THIS
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}